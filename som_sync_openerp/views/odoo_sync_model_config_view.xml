<?xml version="1.0" encoding="UTF-8"?>
<openerp>
    <data>
        <record model="ir.ui.view" id="view_odoo_sync_model_config_form">
            <field name="name">odoo.sync.model.config.form</field>
            <field name="model">odoo.sync.model.config</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Odoo Sync Model Configuration">
                    <field name="model_id"/>
                    <field name="auto_sync"/>
                    <field name="async_enabled"/>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="view_odoo_sync_model_config_tree">
            <field name="name">odoo.sync.model.config.tree</field>
            <field name="model">odoo.sync.model.config</field>
            <field name="type">tree</field>
            <field name="arch" type="xml">
                <tree string="Odoo Sync Model Configuration">
                    <field name="model_id" select="1"/>
                    <field name="auto_sync" select="1"/>
                    <field name="async_enabled" select="1"/>
                </tree>
            </field>
        </record>

        <record id="action_odoo_sync_model_config" model="ir.actions.act_window">
            <field name="name">Sync Models Configuration</field>
            <field name="res_model">odoo.sync.model.config</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_odoo_sync_model_config_tree"/>
        </record>

        <menuitem
            action="action_odoo_sync_model_config"
            id="menu_action_odoo_sync_model_config"
            parent="menu_folder_odoo_sync"
            sequence="20"/>
    </data>
</openerp>
