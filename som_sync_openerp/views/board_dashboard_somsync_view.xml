<?xml version="1.0" encoding="UTF-8"?>
<openerp>
    <data>
        <!-- Vista form del dashboard -->
        <record model="ir.ui.view" id="view_board_dashboard_somsync_form">
            <field name="name">board.dashboard.somsync.form</field>
            <field name="model">board.dashboard.somsync</field>
            <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Dashboard Sincronització" version="7.0">
                    <sheet>
                        <div class="oe_title">
                            <h1>Dashboard Sincronització OpenERP-Odoo</h1>
                        </div>
                        <group string="Factures (account.invoice)" colspan="4">
                            <group>
                                <field name="total_invoices_syncable" readonly="1"
                                    string="Sincronitzables" widget="integer"
                                    options="{'title': 'Factures amb journal habilitat i estat open/paid'}"/>
                            </group>
                            <group>
                                <field name="total_invoices_synced" readonly="1"
                                    string="Sincronitzades" widget="integer"
                                    options="{'title': 'Factures amb sync_state synced o synced_with_warning'}"/>
                            </group>
                        </group>
                        <group string="Assentaments (account.move)" colspan="4">
                            <group>
                                <field name="total_moves_syncable" readonly="1"
                                    string="Sincronitzables" widget="integer"
                                    options="{'title': 'Assentaments amb journal habilitat'}"/>
                            </group>
                            <group>
                                <field name="total_moves_synced" readonly="1"
                                    string="Sincronitzats" widget="integer"
                                    options="{'title': 'Assentaments amb sync_state synced o synced_with_warning'}"/>
                            </group>
                        </group>
                        <separator string="Resum total" colspan="4"/>
                        <group colspan="4">
                            <group>
                                <field name="total_syncable" readonly="1"
                                    string="Total sincronitzables"/>
                            </group>
                            <group>
                                <field name="total_synced" readonly="1"
                                    string="Total sincronitzats"/>
                            </group>
                            <group>
                                <field name="pct_synced" readonly="1"
                                    string="% Sincronitzats" widget="float"
                                    options="{'digits': [5,2]}"/>
                            </group>
                        </group>
                        <group colspan="4">
                            <field name="date_start" readonly="1"
                                string="Data inici filtre"/>
                        </group>
                    </sheet>
                    <footer>
                        <button string="Actualitzar" name="refresh_dashboard"
                            type="object" class="oe_highlight"/>
                        <button string="Tancar" class="oe_highlight"
                            special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <!-- Acció per obrir el dashboard -->
        <record model="ir.actions.act_window" id="action_board_dashboard_somsync">
            <field name="name">Dashboard Sincronització</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">board.dashboard.somsync</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="context">{'default_display_name': 'Dashboard Sincronització'}</field>
            <field name="target">new</field>
        </record>

        <!-- Menuitem -->
        <menuitem
            id="menu_board_dashboard_somsync"
            name="Dashboard Sincronització"
            action="action_board_dashboard_somsync"
            parent="menu_folder_odoo_sync"
            sequence="1"
            icon="terp-graph"
        />
    </data>
</openerp>
