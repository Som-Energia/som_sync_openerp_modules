            <field name="limit" eval="0"/>
            <field name="res_model">board.dashboard.somsync.summary</field>
            <field name="domain">[('model_name', '=', 'account.move'), ('sync_state', 'in', ['synced', 'synced_with_warning'])]</field>
        </record>
        <record model="ir.actions.act_window.view" id="action_view_somsync_move_synced">
