<?xml version="1.0" encoding="UTF-8"?>
<openerp>
    <data>
        <!-- Board definition -->
        <record model="board.board" id="dashboard_somsync">
            <field name="name" eval="'Sincronitzacio OpenERP-Odoo'"/>
        </record>

        <!-- ===== Factures ===== -->
        <!-- Indicador: Factures sincronitzables -->
        <record model="ir.ui.view" id="view_dashboard_somsync_inv_syncable">
            <field name="name">Factures sincronitzables</field>
            <field name="model">board.dashboard.somsync.summary</field>
            <field name="type">graph</field>
            <field name="priority" eval="16"/>
            <field name="version" eval="2"/>
            <field name="arch" type="xml">
                <graph type="indicator"/>
            </field>
        </record>
        <record model="ir.actions.act_window" id="action_dashboard_somsync_inv_syncable">
            <field name="name">Factures sincronitzables</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_type">form</field>
            <field name="view_mode">graph,tree,form</field>
            <field name="limit" eval="0"/>
            <field name="res_model">board.dashboard.somsync.summary</field>
            <field name="domain">[('model_name', '=', 'account.invoice')]</field>
        </record>
        <record model="ir.actions.act_window.view" id="action_view_somsync_inv_syncable">
            <field name="sequence" eval="1"/>
            <field name="view_mode">graph</field>
            <field name="view_id" ref="view_dashboard_somsync_inv_syncable"/>
            <field name="act_window_id" ref="action_dashboard_somsync_inv_syncable"/>
        </record>
        <record model="board.board.line" id="board_line_somsync_inv_syncable">
            <field name="board_id" ref="dashboard_somsync"/>
            <field name="sequence" eval="1"/>
            <field name="name">Factures sincronitzables</field>
            <field name="action_id" ref="action_dashboard_somsync_inv_syncable"/>
        </record>

        <!-- Indicador: Factures sincronitzades -->
        <record model="ir.ui.view" id="view_dashboard_somsync_inv_synced">
            <field name="name">Factures sincronitzades</field>
            <field name="model">board.dashboard.somsync.summary</field>
            <field name="type">graph</field>
            <field name="priority" eval="16"/>
            <field name="version" eval="2"/>
            <field name="arch" type="xml">
                <graph type="indicator"/>
            </field>
        </record>
        <record model="ir.actions.act_window" id="action_dashboard_somsync_inv_synced">
            <field name="name">Factures sincronitzades</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_type">form</field>
            <field name="view_mode">graph,tree,form</field>
            <field name="limit" eval="0"/>
            <field name="res_model">board.dashboard.somsync.summary</field>
            <field name="domain">[('model_name', '=', 'account.invoice'), ('sync_state', 'in', ['synced', 'synced_with_warning'])]</field>
        </record>
        <record model="ir.actions.act_window.view" id="action_view_somsync_inv_synced">
            <field name="sequence" eval="1"/>
            <field name="view_mode">graph</field>
            <field name="view_id" ref="view_dashboard_somsync_inv_synced"/>
            <field name="act_window_id" ref="action_dashboard_somsync_inv_synced"/>
        </record>
        <record model="board.board.line" id="board_line_somsync_inv_synced">
            <field name="board_id" ref="dashboard_somsync"/>
            <field name="sequence" eval="2"/>
            <field name="name">Factures sincronitzades</field>
            <field name="action_id" ref="action_dashboard_somsync_inv_synced"/>
        </record>

