        <!-- Indicador: Assentaments sincronitzats -->
        <record model="ir.ui.view" id="view_dashboard_somsync_move_synced">
            <field name="name">Assentaments sincronitzats</field>
            <field name="model">board.dashboard.somsync.summary</field>
            <field name="type">graph</field>
            <field name="priority" eval="16"/>
            <field name="version" eval="2"/>
            <field name="arch" type="xml">
                <graph type="indicator"/>
            </field>
        </record>
        <record model="ir.actions.act_window" id="action_dashboard_somsync_move_synced">
            <field name="name">Assentaments sincronitzats</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_type">form</field>
