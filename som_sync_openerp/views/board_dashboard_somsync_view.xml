        </record>

        <!-- Menuitem -->
        <menuitem
            id="menu_board_dashboard_somsync"
            name="Dashboard Sincronitzacio"
            action="action_dashboard_somsync_inv_syncable"
            parent="menu_folder_odoo_sync"
            sequence="1"
            icon="terp-graph"
        />
    </data>
</openerp>
