<?xml version="1.0" encoding="UTF-8"?>
<openerp>
    <data noupdate="1">

        <!-- ============================================================ -->
        <!-- custom.search records: SQL queries returning metrics          -->
        <!-- Each query returns (name, value) for a single metric          -->
        <!-- ============================================================ -->

        <!-- Factures sincronitzables -->
        <record id="custom_search_dashboard_somsync_inv_syncable"
                model="custom.search">
            <field name="name">[DASHBOARDS][SOM Sync] Factures sincronitzables des de 01/01/2026</field>
            <field name="query">
SELECT
    'Factures sincronitzables' AS name,
    COUNT(*) AS value
FROM account_invoice ai
INNER JOIN account_journal aj ON ai.journal_id = aj.id
WHERE aj.som_sync_odoo_invoices = True
  AND ai.state IN ('open', 'paid')
  AND ai.date_invoice &gt;= '2026-01-01'
            </field>
        </record>

        <!-- Factures sincronitzades -->
        <record id="custom_search_dashboard_somsync_inv_synced"
                model="custom.search">
            <field name="name">[DASHBOARDS][SOM Sync] Factures sincronitzades des de 01/01/2026</field>
            <field name="query">
SELECT
    'Factures sincronitzades' AS name,
    COUNT(*) AS value
FROM account_invoice ai
INNER JOIN account_journal aj ON ai.journal_id = aj.id
INNER JOIN ir_model im ON im.model = 'account.invoice'
INNER JOIN odoo_sync os ON os.model = im.id AND os.res_id = ai.id
    AND os.sync_state IN ('synced', 'synced_with_warning')
WHERE aj.som_sync_odoo_invoices = True
  AND ai.state IN ('open', 'paid')
  AND ai.date_invoice &gt;= '2026-01-01'
            </field>
        </record>

        <!-- Assentaments sincronitzables -->
        <record id="custom_search_dashboard_somsync_move_syncable"
                model="custom.search">
            <field name="name">[DASHBOARDS][SOM Sync] Assentaments sincronitzables des de 01/01/2026</field>
            <field name="query">
SELECT
    'Assentaments sincronitzables' AS name,
    COUNT(*) AS value
FROM account_move am
INNER JOIN account_journal aj ON am.journal_id = aj.id
WHERE aj.som_sync_odoo_account_moves = True
  AND am.date &gt;= '2026-01-01'
            </field>
        </record>

        <!-- Assentaments sincronitzats -->
        <record id="custom_search_dashboard_somsync_move_synced"
                model="custom.search">
            <field name="name">[DASHBOARDS][SOM Sync] Assentaments sincronitzats des de 01/01/2026</field>
            <field name="query">
SELECT
    'Assentaments sincronitzats' AS name,
    COUNT(*) AS value
FROM account_move am
INNER JOIN account_journal aj ON am.journal_id = aj.id
INNER JOIN ir_model im ON im.model = 'account.move'
INNER JOIN odoo_sync os ON os.model = im.id AND os.res_id = am.id
    AND os.sync_state IN ('synced', 'synced_with_warning')
WHERE aj.som_sync_odoo_account_moves = True
  AND am.date &gt;= '2026-01-01'
            </field>
        </record>

        <!-- ============================================================ -->
        <!-- ir.actions.act_window: link to custom.search.results         -->
        <!-- context[b'search_id'] = ref to the custom.search record      -->
        <!-- ============================================================ -->

        <record model="ir.actions.act_window"
                id="action_dashboard_somsync_inv_syncable">
            <field name="name">Factures sincronitzables</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="limit" eval="0"/>
            <field name="res_model">custom.search.results</field>
            <field name="context" eval="{b'search_id': ref('custom_search_dashboard_somsync_inv_syncable')}"/>
            <field name="domain">[]</field>
        </record>

        <record model="ir.actions.act_window"
                id="action_dashboard_somsync_inv_synced">
            <field name="name">Factures sincronitzades</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="limit" eval="0"/>
            <field name="res_model">custom.search.results</field>
            <field name="context" eval="{b'search_id': ref('custom_search_dashboard_somsync_inv_synced')}"/>
            <field name="domain">[]</field>
        </record>

        <record model="ir.actions.act_window"
                id="action_dashboard_somsync_move_syncable">
            <field name="name">Assentaments sincronitzables</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="limit" eval="0"/>
            <field name="res_model">custom.search.results</field>
            <field name="context" eval="{b'search_id': ref('custom_search_dashboard_somsync_move_syncable')}"/>
            <field name="domain">[]</field>
        </record>

        <record model="ir.actions.act_window"
                id="action_dashboard_somsync_move_synced">
            <field name="name">Assentaments sincronitzats</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_type">form</field>
            <field name="view_mode">tree,form</field>
            <field name="limit" eval="0"/>
            <field name="res_model">custom.search.results</field>
            <field name="context" eval="{b'search_id': ref('custom_search_dashboard_somsync_move_synced')}"/>
            <field name="domain">[]</field>
        </record>

        <!-- ============================================================ -->
        <!-- board.board + board.board.line                                 -->
        <!-- ============================================================ -->

        <record model="board.board" id="dashboard_somsync">
            <field name="name" eval="'Sincronitzacio OpenERP-Odoo'"/>
        </record>

        <record model="board.board.line" id="board_line_somsync_inv_syncable">
            <field name="board_id" ref="dashboard_somsync"/>
            <field name="sequence" eval="1"/>
            <field name="name">Factures sincronitzables</field>
            <field name="action_id" ref="action_dashboard_somsync_inv_syncable"/>
        </record>

        <record model="board.board.line" id="board_line_somsync_inv_synced">
            <field name="board_id" ref="dashboard_somsync"/>
            <field name="sequence" eval="2"/>
            <field name="name">Factures sincronitzades</field>
            <field name="action_id" ref="action_dashboard_somsync_inv_synced"/>
        </record>

        <record model="board.board.line" id="board_line_somsync_move_syncable">
            <field name="board_id" ref="dashboard_somsync"/>
            <field name="sequence" eval="3"/>
            <field name="name">Assentaments sincronitzables</field>
            <field name="action_id" ref="action_dashboard_somsync_move_syncable"/>
        </record>

        <record model="board.board.line" id="board_line_somsync_move_synced">
            <field name="board_id" ref="dashboard_somsync"/>
            <field name="sequence" eval="4"/>
            <field name="name">Assentaments sincronitzats</field>
            <field name="action_id" ref="action_dashboard_somsync_move_synced"/>
        </record>

        <!-- ============================================================ -->
        <!-- Menuitem: obre el board.board en form view                    -->
        <!-- ============================================================ -->

        <record model="ir.actions.act_window"
                id="action_dashboard_somsync_board">
            <field name="name">Dashboard Sincronitzacio</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_type">form</field>
            <field name="view_mode">form</field>
            <field name="res_model">board.board</field>
            <field name="domain">[('name', '=', 'Sincronitzacio OpenERP-Odoo')]</field>
            <field name="context">{'active_test': False}</field>
        </record>

        <menuitem
            id="menu_board_dashboard_somsync"
            name="Dashboard Sincronitzacio"
            action="action_dashboard_somsync_board"
            parent="menu_folder_odoo_sync"
            sequence="1"
            icon="terp-graph"
        />

    </data>
</openerp>
