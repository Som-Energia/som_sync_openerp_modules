<openerp>
    <data>
        <record id="view_payment_mode_form_inherit_som_sync" model="ir.ui.view">
            <field name="name">payment.mode.form.inherit.som.sync</field>
            <field name="model">payment.mode</field>
            <field name="inherit_id" ref="account_payment.view_payment_mode_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='bank_id']" position="after">
                    <field name="som_sync_odoo"/>
                </xpath>
            </field>
        </record>
        <record id="view_payment_mode_tree_inherit_som_sync" model="ir.ui.view">
            <field name="name">payment.mode.tree.inherit.som.sync</field>
            <field name="model">payment.mode</field>
            <field name="inherit_id" ref="account_payment.view_payment_mode_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='code']" position="after">
                    <field name="som_sync_odoo"/>
                </xpath>
            </field>
        </record>
    </data>
</openerp>
