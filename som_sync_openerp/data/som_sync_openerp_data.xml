        <record id="odoo_sync_invoice_amount_tolerance" model="res.config">
            <field name="name">odoo_sync_invoice_amount_tolerance</field>
            <field name="value">0.02</field>
            <field name="description">
                Tolerància màxima (en euros) per a discrepàncies d'imports en la sincronització
                de factures. Si la diferència supera aquest valor, el registre es marca com 'error'.
            </field>
        </record>
        <record id="odoo_provider_payment_method" model="res.config">
            <field name="name">odoo_provider_payment_method</field>
            <field name="value">375</field>
            <field name="description">
                Odoo has different payment.method for customers and providers but OpenERP only has one.
                We create a general payment.method for providers in Odoo a this is the odoo_id of it.
            </field>
        </record>
        <record id="odoo_customer_payment_method" model="res.config">
            <field name="name">odoo_customer_payment_method</field>
            <field name="value">373</field>
            <field name="description">
                Odoo has different payment.method for customers and providers but OpenERP only has one.
                We create a general payment.method for customers in Odoo and this is the odoo_id of it.
